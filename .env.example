# ─────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is already in .gitignore
# ─────────────────────────────────────────────────────

# Stripe — get from dashboard.stripe.com → Developers → API Keys
# Use sk_test_... keys for testing, sk_live_... for production
# Price IDs are hardcoded in netlify/functions/create-checkout.js:
#   price_1TGlLHEPNaqEvCxlaB15AIRg = S/M/L/XL ($25)
#   price_1TGlLpEPNaqEvCxlUw5p93xU = XXL/XXXL ($30)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Stripe Webhook Signing Secret
# Get from dashboard.stripe.com → Developers → Webhooks → your endpoint → Signing secret
# For local testing via Stripe CLI, the CLI prints a temporary secret when you run:
#   stripe listen --forward-to localhost:8888/.netlify/functions/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Google Sheets — Sheet ID from the URL of your spreadsheet
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SHEET_ID=REPLACE_ME

# Google Service Account credentials — choose ONE of the two options below:
#
# OPTION A (recommended for local dev):
#   Put the downloaded JSON key file anywhere in the project folder and set the path.
#   The file is gitignored so it won't be committed.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./your-key-file.json
#
# OPTION B (required for Netlify production):
#   Minify the JSON to one line: cat your-key-file.json | python3 -m json.tool --compact
#   Then paste that single line as the value below (no surrounding quotes needed in Netlify dashboard)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Set automatically by Netlify in production — used for success/cancel redirect URLs
# For local testing, netlify dev sets this to http://localhost:8888 automatically
# URL=https://your-site.netlify.app
